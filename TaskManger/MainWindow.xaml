<Window x:Class="TaskManger.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManger"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="1">
            <Image Source="/Images/AlarmClock.jpg" Height="169" Width="203"/>
            <TextBlock Text="מנהל המשימות שלי" HorizontalAlignment="Center" FontWeight="Bold" FontSize="26"/>
            <StackPanel Orientation="Horizontal">
                <Button Height="30" Width="120" Margin="10" Content="משימות פעילות"/>
                <Button Height="30" Width="120" Margin="0"  Content="משימות שהסתיימו"/>
            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="3">
            <TextBlock Text=":משימה חדשה" Margin="80,30,0,0" FontSize="20"/>
            <TextBox Margin="80,30,0,30" Width="206" Height="47"/>
            <ComboBox Margin="80,30,0,30" Width="60">
                <ComboBoxItem Content="נמוכה"/>
                <ComboBoxItem Content="בינונית"/>
                <ComboBoxItem Content="גבוהה"/>
            </ComboBox>
            <Button Content="הוסף"  Margin="80,30,0,30" Width="100" Height="22"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
            <StackPanel Orientation="Vertical">
                <CheckBox Content="לקנות חלב (דחיפות גבוהה) "/>
                <CheckBox Content="ללמוד למבחן במתמטיקה (דחיפות בינונית) "/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
